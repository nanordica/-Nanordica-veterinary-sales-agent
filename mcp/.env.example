# --- Platform ---
MCP_SERVER_NAME=Ravimus MCP
MCP_PORT=8765
LOG_LEVEL=INFO
# Live-safety switch. 1 = log writes but do not perform them. Default ON.
DRY_RUN=1

# --- Pipedrive ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=nanordica.pipedrive.com

# --- MS Graph (app-only) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=ravimus@nanordica.com
GRAPH_DELTA_PATH=./data/graph_delta.json
# Calendar tools: whose free/busy is offered (calendar_* tools). Events are
# created on GRAPH_SENDER's calendar (organizer model), inviting this user +
# the lead. Needs Calendars.Read + Calendars.ReadWrite application
# permissions on the GRAPH_SENDER mailbox only.
GRAPH_CALENDAR_USER=
# flock file serializing check-then-insert in calendar_book_slot.
GRAPH_BOOK_LOCK_PATH=./cache/calendar-book.lock

# --- Wix ---
WIX_API_KEY=
WIX_SITE_ID=
WIX_ACCOUNT_ID=

# Phase 2 safety: comma-separated addresses that may receive mail.
# When set, mail_send refuses every other recipient (not_in_allowlist),
# regardless of DRY_RUN. Unset = no restriction (phase 3 live).
MAIL_ALLOWLIST=
