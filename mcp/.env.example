# --- Platform ---
MCP_SERVER_NAME=Ravimus MCP
MCP_PORT=8765
LOG_LEVEL=INFO
# Live-safety switch. 1 = log writes but do not perform them. Default ON.
DRY_RUN=1

# --- Pipedrive ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=nanordica.pipedrive.com

# --- MS Graph (app-only) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=ravimus@nanordica.com
GRAPH_DELTA_PATH=./data/graph_delta.json

# --- Wix ---
WIX_API_KEY=
WIX_SITE_ID=
WIX_ACCOUNT_ID=

# --- Omniva (OMX API, HTTP Basic; no public sandbox -> keep DRY_RUN=1) ---
# Partner (AXA) code from the business contract; sent as customerCode.
OMNIVA_CUSTOMER_CODE=
OMNIVA_API_USERNAME=
OMNIVA_API_PASSWORD=
# Sender block for shipment registration (senderAddressee).
OMNIVA_SENDER_NAME=Nanordica Medical OÜ
OMNIVA_SENDER_PHONE=
OMNIVA_SENDER_EMAIL=
OMNIVA_SENDER_COUNTRY=EE
OMNIVA_SENDER_POSTCODE=
OMNIVA_SENDER_DELIVERYPOINT=
OMNIVA_SENDER_STREET=
OMNIVA_SENDER_HOUSE_NO=

# Phase 2 safety: comma-separated addresses that may receive mail.
# When set, mail_send refuses every other recipient (not_in_allowlist),
# regardless of DRY_RUN. Unset = no restriction (phase 3 live).
MAIL_ALLOWLIST=
