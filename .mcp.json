{
  "mcpServers": {
    "mail-mcp": {
      "type": "stdio",
      "command": "python3.12",
      "args": ["mcp/mail-mcp/server.py"],
      "env": {
        "DRY_RUN": "1"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "estonian": {
      "type": "http",
      "url": "https://estonian-mcp.fly.dev/mcp"
    },
    "ravimus": {
      "type": "http",
      "url": "http://localhost:8765/mcp"
    }
  }
}
